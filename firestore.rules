rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Public election candidate directory with realtime votes
    match /candidates/{candidateId} {
      allow read, write, delete: if true;
    }

    // Student user profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Student secret ballots (editable by the voter)
    match /votes/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Campus issues and discussions
    match /campusIssues/{issueId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /issues/{issueId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
  }
}
